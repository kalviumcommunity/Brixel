rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- REUSABLE ACCESS CONTROL HELPERS ---

    // True if request is made by an authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null;
    }

    // True if the authenticated user matches the specified user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safely checks if the caller has a specific role via custom claims or user doc
    function hasRole(targetRole) {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == targetRole) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == targetRole
        )
      );
    }

    // Manager role authorization check
    function isManager() {
      return hasRole('manager');
    }

    // Supervisor or Manager role authorization check
    function isSupervisorOrManager() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role in ['supervisor', 'manager']) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supervisor', 'manager']
        )
      );
    }

    // --- COLLECTION ACCESS RULES ---

    // 1. Users Collection (/users/{userId})
    // - Authenticated users can read their own profile; supervisors & managers can read profiles
    // - Self-registration is strictly restricted to role: 'pending' and empty assignedSiteIds
    //   (Prevents users from self-assigning 'supervisor' or 'manager' roles or arbitrary sites)
    // - Elevated roles (supervisor/manager) and site assignments can ONLY be assigned by a manager
    // - Users can update profile display info, but cannot alter role, assignedSiteIds, uid, or email
    match /users/{userId} {
      allow read: if isOwner(userId) || isSupervisorOrManager();
      allow create: if isOwner(userId) && (
        isManager() || (
          request.resource.data.role == 'pending' &&
          (!('assignedSiteIds' in request.resource.data) || request.resource.data.assignedSiteIds.size() == 0)
        )
      );
      allow update: if isManager() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'assignedSiteIds', 'uid', 'email'])
      );
      allow delete: if isManager();
    }

    // 2. Sites Collection (/sites/{siteId})
    // - Any authenticated worker or supervisor can view construction sites
    // - Creating, updating site details, or archiving sites requires supervisor or manager role
    match /sites/{siteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSupervisorOrManager();
    }

    // 3. Attendance Logs (/attendance/{attendanceId})
    // - Authenticated workers and staff can read attendance records
    // - Workers/supervisors can create records where recordedBy matches their auth UID
    // - Updates allowed by author or manager, but audit fields (siteId, recordedBy, date, createdAt) are immutable
    // - Deletions restricted to original author or project manager
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.recordedBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.recordedBy == request.auth.uid || isManager()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['siteId', 'recordedBy', 'date', 'createdAt'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.recordedBy == request.auth.uid || isManager()
      );
    }

    // 4. Materials Inventory (/materials/{materialId})
    // - Authenticated workers can view material stock levels
    // - Creating material types and adjusting stock inventory requires supervisor or manager role
    // - siteId is immutable on update to prevent cross-site inventory corruption
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow create: if isSupervisorOrManager();
      allow update: if isSupervisorOrManager() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['siteId']);
      allow delete: if isManager();
    }

    // 5. Material Transactions Audit Trail (/material_transactions/{txId})
    // - Authenticated users can view transaction logs
    // - Creating a transaction requires author identity integrity (recordedBy == auth.uid) and positive quantity
    // - Transactions are financial/inventory audit records: immutable for regular users
    // - Managers may perform corrections, but core audit keys (materialId, siteId, recordedBy, timestamp) are immutable
    match /material_transactions/{txId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.recordedBy == request.auth.uid &&
        request.resource.data.quantity > 0;
      allow update: if isManager() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['materialId', 'siteId', 'recordedBy', 'timestamp']);
      allow delete: if isManager();
    }

    // 6. Safety Incidents (/incidents/{incidentId})
    // - Authenticated staff can read safety incidents for site hazard awareness
    // - Reporting an incident requires author verification (reportedBy == auth.uid) and initial status 'reported'
    // - Audit fields (siteId, reportedBy, createdAt) are strictly immutable for all users
    // - Original reporter can only edit incident notes/description and cannot alter status or resolution fields
    // - Only supervisors and managers can transition incident status (e.g. reported -> acknowledged -> resolved)
    // - Deleting an incident requires manager role or reporter prior to acknowledgment
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.status == 'reported' &&
        (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null);
      allow update: if isAuthenticated() && (
        // Case A: Original reporter updating incident notes/description (cannot change status or resolution)
        (
          resource.data.reportedBy == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'siteId', 'reportedBy', 'createdAt', 'resolvedBy', 'resolvedAt'
          ])
        ) ||
        // Case B: Supervisor or Manager transitioning status (cannot tamper with original reporter/siteId/createdAt)
        (
          isSupervisorOrManager() &&
          request.resource.data.status in ['reported', 'acknowledged', 'resolved'] &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['siteId', 'reportedBy', 'createdAt'])
        )
      );
      allow delete: if isAuthenticated() && (
        isManager() || (
          resource.data.reportedBy == request.auth.uid && resource.data.status == 'reported'
        )
      );
    }

    // --- DEFAULT DENIAL ---
    // Explicitly block unauthorized access to any unmatched document or collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
